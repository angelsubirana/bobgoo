---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Bobgoo — Clear ideas. Useful software.',
  description = 'Software and digital products from Barcelona. Get in touch at hi@bobgoo.com.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f1" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Bobgoo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      // Keep local previews out of the production property's traffic.
      if (['bobgoo.com', 'www.bobgoo.com'].includes(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        // Enable analytics cookies by default; keep advertising consent denied.
        gtag('consent', 'default', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
        gtag('set', 'ads_data_redaction', true);
        gtag('js', new Date());
        gtag('config', 'G-74BVLBQ1QH', {
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
          // Do not send query strings or fragments that may contain personal data.
          page_location: window.location.origin + window.location.pathname,
          page_referrer: document.referrer ? new URL(document.referrer).origin : '',
        });
        const analytics = document.createElement('script');
        analytics.async = true;
        analytics.src = 'https://www.googletagmanager.com/gtag/js?id=G-74BVLBQ1QH';
        document.head.appendChild(analytics);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <header class="header">
        <a class="wordmark" href="/" aria-label="Bobgoo, home">bobgoo<span aria-hidden="true">.</span></a>
        <span class="header-note">Software & digital products</span>
        <a class="header-contact" href="mailto:hi@bobgoo.com">Let’s talk <span aria-hidden="true">↗</span></a>
      </header>
      <slot />
      <footer class="footer">
        <span>© {new Date().getUTCFullYear()} Bobgoo</span>
        <span class="footer-location">Barcelona, Catalonia <span aria-hidden="true">↗</span></span>
        <nav class="footer-links" aria-label="Footer">
          <a href="/projects/" aria-current={Astro.url.pathname === '/projects/' ? 'page' : undefined}>Projects</a>
          <a href="/privacy/" aria-current={Astro.url.pathname === '/privacy/' ? 'page' : undefined}>Privacy</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
